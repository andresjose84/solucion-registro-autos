        {
          "name": "Obtener auto por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/cars/{{carId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "cars", "{{carId}}"]
            },
            "description": "Obtiene el detalle de un auto por ID. Usa la variable `carId` (por defecto 1)."
          },
          "response": []
        },
        {
          "name": "Crear auto",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const json = pm.response.json();",
                  "    pm.collectionVariables.set('carId', String(json.id));",
                  "    if (pm.environment.name) pm.environment.set('carId', String(json.id));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"brand\": \"Toyota\",\n  \"model\": \"Corolla\",\n  \"year\": 2023,\n  \"plate\": \"XYZ789\",\n  \"color\": \"Gris\",\n  \"photoUrl\": \"https://placehold.co/400x250/1e293b/ffffff?text=Toyota+Corolla\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/cars",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "cars"]
            },
            "description": "Crea un auto. Placa formato colombiano (ej. MWK737). El ID creado se guarda en `carId`."
          },
          "response": []
        },
        {
          "name": "Actualizar auto",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"brand\": \"Toyota\",\n  \"model\": \"Corolla XEI\",\n  \"year\": 2023,\n  \"plate\": \"XYZ789\",\n  \"color\": \"Plata\",\n  \"photoUrl\": \"https://placehold.co/400x250/1e293b/ffffff?text=Toyota+Corolla+XEi\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/cars/{{carId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "cars", "{{carId}}"]
            },
            "description": "Actualiza un auto existente por ID."
